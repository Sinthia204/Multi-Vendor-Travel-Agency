        <mxCell id="edge3a" value="save booking" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#000000;fontSize=11;" edge="1" parent="1" source="step_create" target="d4_l2"><mxGeometry relative="1" as="geometry"/></mxCell>
