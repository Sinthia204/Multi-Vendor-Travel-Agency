        <mxCell id="edge5b" value="rejected -> update booking" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;strokeColor=#000000;fontSize=11;" edge="1" parent="1" source="step_approve" target="step_update_booking"><mxGeometry relative="1" as="geometry"/></mxCell>
